[gd_scene format=3]

[ext_resource type="Script" path="res://round_interface/round_interface.gd" id="script"]
[ext_resource type="Script" path="res://round_interface/score_sequence.gd" id="sequence"]
[ext_resource type="PackedScene" path="res://table_stage/table_stage.tscn" id="stage"]
[ext_resource type="PackedScene" path="res://dice_hold/dice_hold_controller.tscn" id="hold"]
[ext_resource type="PackedScene" path="res://round_interface/audio/round_audio.tscn" id="audio"]
[ext_resource type="PackedScene" path="res://round_interface/hud/round_hud.tscn" id="hud"]

[node name="RoundInterface" type="Node3D"]
script = ExtResource("script")

[node name="Stage" parent="." instance=ExtResource("stage")]

[node name="HoldController" parent="." instance=ExtResource("hold")]
show_highlight = false

[node name="Audio" parent="." instance=ExtResource("audio")]

[node name="Sequence" type="Node" parent="."]
script = ExtResource("sequence")

[node name="Interface" type="CanvasLayer" parent="."]

[node name="Hud" parent="Interface" instance=ExtResource("hud")]
