	for keyword: KeywordDefinition in keywords:
		if keyword.id == &"points":
			keyword.color_role = &"points"
		elif keyword.id == &"mult":
			keyword.color_role = &"mult"
		elif keyword.id == &"coins" or keyword.id == &"shop_refresh":
			keyword.color_role = &"coins"
		elif String(keyword.id).begins_with("combination") or keyword.id in [&"matching", &"straight", &"member", &"joker"]:
			keyword.color_role = &"combination"
		elif keyword.id in [&"held", &"validated", &"validation"]:
			keyword.color_role = &"selection"
		elif keyword.id in [&"reroll", &"round"]:
			keyword.color_role = &"tempo"
